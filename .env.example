GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=sqlite:///./stock_agent.db

# Account ID shown after web login. Empty means no operator.
ADMIN_ACCOUNT_ID=
# Built web: 8000. Vite development: http://127.0.0.1:5173.
WEB_ORIGIN=http://127.0.0.1:8000
# Keep true for HTTPS. Set false explicitly only for local HTTP development.
WEB_COOKIE_SECURE=true

KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_REDIRECT_URI=http://127.0.0.1:8000/auth/kakao/callback
KAKAO_NOTIFICATION_REDIRECT_URI=http://127.0.0.1:8000/notification-connections/kakao/callback
# Optional: set only when Client Secret is enabled in Kakao Developers.
KAKAO_CLIENT_SECRET=
# Generate once with Fernet.generate_key() and keep it stable.
NOTIFICATION_TOKEN_FERNET_KEY=

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_TIMEZONE=Asia/Seoul
SCHEDULER_MARKET_START_HOUR=8
SCHEDULER_MARKET_END_HOUR=16

# Continuous briefings (independent of rule-alert scheduler).
BRIEFING_SCHEDULER_ENABLED=true
# Korean official disclosures: Open DART API key.
DART_API_KEY=
# US official disclosures: identify your app/operator and contact email to SEC.
SEC_USER_AGENT=
# 종목 기준정보 갱신: 정책 확정. 실제 계정 --verify 성공 및 범위·한도 확인 후 활성화
CATALOG_SCHEDULER_ENABLED=false
KRX_API_KEY=
ALPHA_VANTAGE_API_KEY=
CATALOG_KR_INTERVAL_MINUTES=60
CATALOG_US_INTERVAL_MINUTES=360
CATALOG_MAX_SOURCE_AGE_DAYS=7
CATALOG_MAX_FETCH_AGE_HOURS=48

# 내부 요청 예산: 최근 24시간, 배치당 2회 예약 (다른 앱의 공유 키 사용량은 별도)
CATALOG_KR_REQUESTS_PER_24H=96
CATALOG_US_REQUESTS_PER_24H=20
# 운영 원문·실행 이력. 현재 게시본·상폐 근거·사용자 기록은 제외.
CATALOG_SNAPSHOT_RETENTION_DAYS=90
CATALOG_ATTEMPT_RETENTION_DAYS=365
